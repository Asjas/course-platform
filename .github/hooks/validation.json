{
  "hooks": {
    "PostToolUse": [
      {
        "command": "node .github/hooks/scripts/post-tool-use-quality.mjs",
        "cwd": ".",
        "timeout": 180,
        "type": "command"
      }
    ],
    "PreToolUse": [
      {
        "command": "node .github/hooks/scripts/pre-tool-use-safety.mjs",
        "cwd": ".",
        "timeout": 30,
        "type": "command"
      }
    ],
    "SessionStart": [
      {
        "command": "node .github/hooks/scripts/session-start-validate.mjs",
        "cwd": ".",
        "timeout": 30,
        "type": "command"
      }
    ],
    "Stop": [
      {
        "command": "node .github/hooks/scripts/stop-gate.mjs",
        "cwd": ".",
        "timeout": 1800,
        "type": "command"
      }
    ]
  }
}
