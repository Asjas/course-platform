{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "dependencyDashboard": true,
  "extends": ["config:recommended"],
  "timezone": "Africa/Johannesburg",
  "assignees": ["Asjas"],
  "labels": ["renovate"],
  "rangeStrategy": "update-lockfile",
  "packageRules": [
    {
      "matchPackageNames": ["lucide-react"],
      "enabled": false,
      "description": "lucide-react 1.x removed YoutubeIcon and other icons with breaking renames; pinned to 0.577.x until migration is done"
    },
    {
      "matchPackageNames": ["eslint", "@eslint/js"],
      "matchUpdateTypes": ["major"],
      "enabled": false,
      "description": "ESLint 10 not yet supported by most plugins (react, react-hooks, promise, jsx-a11y, import, tanstack-query)"
    },
    {
      "matchPackageNames": [
        "@trpc/client",
        "@trpc/server",
        "@trpc/tanstack-react-query"
      ],
      "matchCurrentVersion": ">=11.14.0",
      "enabled": false,
      "description": "tRPC >=11.14.0 causes TS2742 errors with composite tsconfig (TrackedData type not portable); waiting for upstream fix"
    },
    {
      "matchPackageNames": ["typescript"],
      "matchUpdateTypes": ["major"],
      "enabled": false,
      "description": "TypeScript 6.x causes TS2883 errors with tRPC router exports (stricter declaration emit); waiting for tRPC upstream fix"
    },
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "recreateWhen": "always",
    "rebaseWhen": "behind-base-branch",
    "branchTopic": "lock-file-maintenance",
    "commitMessageAction": "Lock file maintenance",
    "schedule": ["before 5am on monday"],
    "prBodyDefinitions": {
      "Change": "All locks refreshed"
    }
  }
}
