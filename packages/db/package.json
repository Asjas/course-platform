{
  "name": "@packages/db",
  "type": "module",
  "author": "A-J Roos <asjasroos@proton.me>",
  "license": "MIT",
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts"
    },
    "./schema": {
      "import": "./src/schema/index.ts"
    },
    "./schema/user": {
      "import": "./src/schema/user.ts"
    },
    "./schema/coupon": {
      "import": "./src/schema/coupon.ts"
    },
    "./schema/course": {
      "import": "./src/schema/course.ts"
    },
    "./schema/enrollment": {
      "import": "./src/schema/enrollment.ts"
    },
    "./schema/purchase": {
      "import": "./src/schema/purchase.ts"
    },
    "./schema/support-ticket": {
      "import": "./src/schema/support-ticket.ts"
    },
    "./schema/team-license": {
      "import": "./src/schema/team-license.ts"
    },
    "./schema/progress": {
      "import": "./src/schema/progress.ts"
    },
    "./schema/platform-announcement": {
      "import": "./src/schema/platform-announcement.ts"
    }
  },
  "scripts": {
    "drizzle:generate": "tsx --env-file=.env node_modules/drizzle-kit/bin.cjs generate",
    "drizzle:migrate": "tsx --env-file=.env node_modules/drizzle-kit/bin.cjs migrate",
    "drizzle:drop": "tsx --env-file=.env node_modules/drizzle-kit/bin.cjs drop"
  },
  "dependencies": {
    "@packages/schema": "workspace:*",
    "drizzle-orm": "0.44.7",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/pg": "8.15.6",
    "drizzle-kit": "0.31.6",
    "typescript": "5.9.3",
    "tsx": "4.20.6",
    "tsconfig-paths": "4.2.0"
  },
  "optionalDependencies": {
    "pg-native": "3.5.2"
  }
}
