{
  "name": "@packages/db",
  "type": "module",
  "author": "A-J Roos <asjasroos@proton.me>",
  "license": "MIT",
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema/user": {
      "types": "./dist/schema/user.d.ts",
      "import": "./dist/schema/user.js"
    },
    "./schema/coupon": {
      "types": "./dist/schema/coupon.d.ts",
      "import": "./dist/schema/coupon.js"
    },
    "./schema/course": {
      "types": "./dist/schema/course.d.ts",
      "import": "./dist/schema/course.js"
    },
    "./schema/enrollment": {
      "types": "./dist/schema/enrollment.d.ts",
      "import": "./dist/schema/enrollment.js"
    },
    "./schema/purchase": {
      "types": "./dist/schema/purchase.d.ts",
      "import": "./dist/schema/purchase.js"
    },
    "./schema/support-ticket": {
      "types": "./dist/schema/support-ticket.d.ts",
      "import": "./dist/schema/support-ticket.js"
    },
    "./schema/team-license": {
      "types": "./dist/schema/team-license.d.ts",
      "import": "./dist/schema/team-license.js"
    },
    "./schema/progress": {
      "types": "./dist/schema/progress.d.ts",
      "import": "./dist/schema/progress.js"
    },
    "./schema/platform-announcement": {
      "types": "./dist/schema/platform-announcement.d.ts",
      "import": "./dist/schema/platform-announcement.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "drizzle:generate": "tsx node_modules/drizzle-kit/bin.cjs generate",
    "drizzle:migrate": "tsx node_modules/drizzle-kit/bin.cjs migrate",
    "drizzle:drop": "tsx node_modules/drizzle-kit/bin.cjs drop"
  },
  "dependencies": {
    "@packages/schema": "workspace:*",
    "drizzle-orm": "0.44.7",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/pg": "8.15.6",
    "drizzle-kit": "0.31.6",
    "typescript": "5.9.3",
    "tsx": "4.20.6",
    "tsconfig-paths": "4.2.0"
  },
  "optionalDependencies": {
    "pg-native": "3.5.2"
  }
}
