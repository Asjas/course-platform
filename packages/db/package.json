{
  "name": "@packages/db",
  "type": "module",
  "author": "A-J Roos <asjasroos@proton.me>",
  "license": "MIT",
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "drizzle:generate": "tsx node_modules/drizzle-kit/bin.cjs generate",
    "drizzle:migrate": "tsx node_modules/drizzle-kit/bin.cjs migrate",
    "drizzle:drop": "tsx node_modules/drizzle-kit/bin.cjs drop"
  },
  "dependencies": {
    "@packages/schema": "workspace:*",
    "drizzle-orm": "0.44.7",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/pg": "8.15.6",
    "drizzle-kit": "0.31.6",
    "typescript": "5.9.3",
    "tsx": "4.20.6",
    "tsconfig-paths": "4.2.0"
  },
  "optionalDependencies": {
    "pg-native": "3.5.2"
  }
}
