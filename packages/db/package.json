{
  "name": "@packages/db",
  "type": "module",
  "author": "A-J Roos <asjasroos@proton.me>",
  "license": "MIT",
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.ts",
      "default": "./dist/schema/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "drizzle:migrate": "drizzle-kit migrate --config=../../packages/db/drizzle.config.ts",
    "drizzle:generate": "drizzle-kit generate --config=../../packages/db/drizzle.config.ts",
    "drizzle:drop": "drizzle-kit drop",
    "drizzle:migrate:prod": "drizzle-kit migrate --config=../../packages/db/drizzle.config.js"
  },
  "dependencies": {
    "@packages/schema": "workspace:*",
    "drizzle-orm": "0.44.7",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/pg": "8.15.6",
    "drizzle-kit": "0.31.6",
    "typescript": "5.9.3"
  },
  "optionalDependencies": {
    "pg-native": "3.5.2"
  }
}
