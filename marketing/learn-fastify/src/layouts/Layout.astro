---
import "../styles/global.css";
---

<!doctype html>
<html
  lang="en"
  class="custom-scrollbar dark"
>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width"
    />
    <link
      rel="icon"
      type="image/x-icon"
      href="/favicon.ico"
    />
    <meta
      name="generator"
      content={Astro.generator}
    />
    <title>Learn Fastify</title>
    <meta
      name="description"
      content="Learn Fastify - A comprehensive course to the Fastify framework."
    />
    <link
      rel="canonical"
      href="https://learnfastify.com"
    />
    <meta
      name="robots"
      content="index, follow"
    />
    <meta
      name="keywords"
      content="Fastify, Node.js, backend, web framework, course, tutorial"
    />
    <meta
      property="og:type"
      content="website"
    />
    <meta
      property="og:title"
      content="Learn Fastify — A comprehensive Fastify course"
    />
    <meta
      property="og:description"
      content="Learn Fastify - A comprehensive course to the Fastify framework."
    />
    <meta
      property="og:image"
      content="/social/learn-fastify-og.png"
    />
    <meta
      property="og:url"
      content="https://learnfastify.com"
    />
    <meta
      name="twitter:card"
      content="summary_large_image"
    />
    <meta
      name="twitter:title"
      content="Learn Fastify — A comprehensive Fastify course"
    />
    <meta
      name="twitter:description"
      content="Learn Fastify - A comprehensive course to the Fastify framework."
    />
    <meta
      name="twitter:image"
      content="/social/learn-fastify-og.png"
    />
    <link
      rel="manifest"
      href="/site.webmanifest"
    />
    <meta
      name="theme-color"
      content="#0ea5a4"
    />
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "Learn Fastify",
        "url": "https://learnfastify.com",
        "description": "Learn Fastify - A comprehensive course to the Fastify framework."
      }
    </script>
    <!-- Theme initialization to prevent FOUC -->
    <script is:inline>
      (function () {
        const saved = localStorage.getItem("learnfastify-theme");
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;
        const isDark = saved ? saved === "dark" : prefersDark;
        document.documentElement.classList.toggle("dark", isDark);
      })();
    </script>
  </head>
  <body
    class="min-h-screen bg-white text-gray-900 antialiased dark:bg-gray-900 dark:text-gray-100"
  >
    <slot />
  </body>
</html>
