---
const techStack = [
  {
    name: "Fastify",
    description: "High-performance Node.js web framework",
    icon: "/fastify-icon.svg",
    invertDark: true,
  },
  {
    name: "React",
    description: "Modern UI development with hooks and TypeScript",
    icon: "/react-icon.svg",
    invertDark: false,
  },
  {
    name: "PostgreSQL",
    description: "Robust relational database with Drizzle ORM",
    icon: "/postgres-icon.svg",
    invertDark: false,
  },
  {
    name: "TypeScript",
    description: "Type-safe development from end to end",
    icon: "/typescript-icon.svg",
    invertDark: false,
  },
];
---

<section class="bg-gray-50 py-20 dark:bg-gray-800/50">
  <div class="container mx-auto max-w-6xl px-4">
    <div class="mb-16 text-center">
      <h2
        class="mb-4 text-3xl font-bold text-gray-900 sm:text-4xl dark:text-white"
      >
        What You'll Build
      </h2>
      <p class="mx-auto max-w-2xl text-lg text-gray-600 dark:text-gray-300">
        Build a complete, production-ready online store from scratch, covering
        everything from authentication to payment processing.
      </p>
    </div>

    <div class="grid gap-8 lg:grid-cols-2">
      <!-- Project Preview -->
      <div
        class="relative overflow-hidden rounded-2xl border border-gray-200 bg-white p-2 shadow-xl dark:border-gray-700 dark:bg-gray-800"
      >
        <div
          class="aspect-video overflow-hidden rounded-lg bg-gradient-to-br from-green-500 to-emerald-500"
        >
          <div
            class="flex h-full flex-col items-center justify-center p-8 text-white"
          >
            <svg
              class="mb-4 h-16 w-16 opacity-80"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"
              ></path>
            </svg>
            <h3 class="text-2xl font-bold">Online Store</h3>
            <p class="mt-2 text-center opacity-90"
              >Full-stack e-commerce application</p
            >
          </div>
        </div>
        <div
          class="absolute -right-4 -bottom-4 h-24 w-24 rounded-full bg-gradient-to-br from-emerald-500/20 to-green-500/20 blur-2xl"
          aria-hidden="true"
        ></div>
      </div>

      <!-- Features List -->
      <div class="space-y-6">
        <div
          class="rounded-xl border border-gray-200 bg-white p-6 transition-shadow hover:shadow-lg dark:border-gray-700 dark:bg-gray-800"
        >
          <div
            class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-green-100 dark:bg-green-900/30"
          >
            <svg
              class="h-6 w-6 text-green-600 dark:text-green-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"
              ></path>
            </svg>
          </div>
          <h3 class="mb-2 text-lg font-semibold text-gray-900 dark:text-white"
            >Product Catalog</h3
          >
          <p class="text-gray-600 dark:text-gray-300"
            >Browse, search, and filter products with full-text search and
            advanced filtering</p
          >
        </div>

        <div
          class="rounded-xl border border-gray-200 bg-white p-6 transition-shadow hover:shadow-lg dark:border-gray-700 dark:bg-gray-800"
        >
          <div
            class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-emerald-100 dark:bg-emerald-900/30"
          >
            <svg
              class="h-6 w-6 text-emerald-600 dark:text-emerald-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
              ></path>
            </svg>
          </div>
          <h3 class="mb-2 text-lg font-semibold text-gray-900 dark:text-white"
            >Authentication System</h3
          >
          <p class="text-gray-600 dark:text-gray-300"
            >Secure auth with sessions, OAuth providers, and password reset
            flows</p
          >
        </div>

        <div
          class="rounded-xl border border-gray-200 bg-white p-6 transition-shadow hover:shadow-lg dark:border-gray-700 dark:bg-gray-800"
        >
          <div
            class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-purple-100 dark:bg-purple-900/30"
          >
            <svg
              class="h-6 w-6 text-purple-600 dark:text-purple-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"
              ></path>
            </svg>
          </div>
          <h3 class="mb-2 text-lg font-semibold text-gray-900 dark:text-white"
            >Payment Processing</h3
          >
          <p class="text-gray-600 dark:text-gray-300"
            >Complete checkout flow with Stripe integration and order management</p
          >
        </div>
      </div>
    </div>

    <!-- Tech Stack -->
    <div class="mt-16">
      <h3
        class="mb-8 text-center text-lg font-semibold text-gray-500 dark:text-gray-400"
        >TECH STACK</h3
      >
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          techStack.map((tech) => (
            <div class="group flex items-center gap-4 rounded-xl border border-gray-200 bg-white p-4 transition-all hover:border-green-500/50 hover:shadow-lg dark:border-gray-700 dark:bg-gray-800 dark:hover:border-green-400/50">
              <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-gray-100 dark:bg-gray-700">
                <img
                  src={tech.icon}
                  alt=""
                  class:list={["h-8 w-8", tech.invertDark && "dark:invert"]}
                  aria-hidden="true"
                />
              </div>
              <div>
                <h4 class="font-semibold text-gray-900 dark:text-white">
                  {tech.name}
                </h4>
                <p class="text-sm text-gray-500 dark:text-gray-400">
                  {tech.description}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
