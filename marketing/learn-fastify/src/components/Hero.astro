---
import SignupForm from "./SignupForm";
---

<section class="relative overflow-hidden pt-32 pb-20 sm:pt-40 sm:pb-32">
  <!-- Background gradient -->
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-b from-green-50/50 via-white to-white dark:from-green-950/30 dark:via-gray-900 dark:to-gray-900"
    aria-hidden="true"
  ></div>

  <!-- Grid pattern -->
  <div
    class="absolute inset-0 -z-10 opacity-30 dark:opacity-20"
    aria-hidden="true"
  >
    <svg
      class="h-full w-full"
      xmlns="http://www.w3.org/2000/svg"
    >
      <defs>
        <pattern
          id="grid"
          width="40"
          height="40"
          patternUnits="userSpaceOnUse"
        >
          <path
            d="M 40 0 L 0 0 0 40"
            fill="none"
            stroke="currentColor"
            stroke-width="0.5"
            class="text-gray-300 dark:text-gray-700"
          ></path>
        </pattern>
      </defs>
      <rect
        width="100%"
        height="100%"
        fill="url(#grid)"
      ></rect>
    </svg>
  </div>

  <div class="container mx-auto max-w-6xl px-4">
    <div class="mx-auto max-w-3xl text-center">
      <!-- Badge -->
      <div
        class="mb-6 inline-flex items-center gap-2 rounded-full border border-green-200 bg-green-50 px-4 py-1.5 text-sm font-medium text-green-700 dark:border-green-800 dark:bg-green-900/30 dark:text-green-400"
      >
        <span class="relative flex h-2 w-2">
          <span
            class="absolute inline-flex h-full w-full animate-ping rounded-full bg-green-400 opacity-75"
          ></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-green-500"
          ></span>
        </span>
        Coming Soon — Join the Waitlist
      </div>

      <!-- Headline -->
      <h1
        class="mb-6 text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl lg:text-6xl dark:text-white"
      >
        Master
        <span
          class="bg-gradient-to-r from-green-500 to-emerald-500 bg-clip-text text-transparent"
        >
          Fastify
        </span>
        and Build Production-Ready APIs
      </h1>

      <!-- Subheadline -->
      <p class="mb-10 text-lg text-gray-600 sm:text-xl dark:text-gray-300">
        A comprehensive, project-based course that takes you from beginner to
        advanced Fastify development. Build a complete online store with React
        frontend and Fastify backend.
      </p>

      <!-- Signup Form -->
      <div
        id="signup"
        class="mx-auto max-w-xl"
      >
        <SignupForm
          client:load
          variant="hero"
        />
      </div>

      <!-- Social proof -->
      <div
        class="mt-10 flex flex-wrap items-center justify-center gap-6 text-sm text-gray-500 dark:text-gray-400"
      >
        <div class="flex items-center gap-2">
          <svg
            class="h-5 w-5 text-yellow-500"
            fill="currentColor"
            viewBox="0 0 20 20"
          >
            <path
              d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
            ></path>
          </svg>
          <span>Early access pricing available</span>
        </div>
        <div class="flex items-center gap-2">
          <svg
            class="h-5 w-5 text-green-500"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
            ></path>
          </svg>
          <span>No spam, unsubscribe anytime</span>
        </div>
      </div>
    </div>
  </div>
</section>
