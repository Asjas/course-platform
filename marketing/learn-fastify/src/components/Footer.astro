---
const currentYear = new Date().getFullYear();
---

<footer
  class="mt-auto border-t border-gray-200 bg-gray-50 dark:border-gray-700 dark:bg-gray-900"
>
  <div class="px-4 py-8 md:px-6 md:py-12 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div
        class="flex flex-col space-y-4 md:flex-row md:items-center md:justify-between md:space-y-0"
      >
        <div class="flex flex-col space-y-2">
          <div class="text-sm font-medium text-gray-900 dark:text-gray-100">
            <a
              class="transition-colors hover:text-emerald-600 dark:hover:text-emerald-400"
              href="/"
            >
              Learn Fastify
            </a>
            <span>© {currentYear}</span>
          </div>
          <div class="text-sm text-gray-600 dark:text-gray-400">
            <a
              class="transition-colors hover:text-emerald-600 dark:hover:text-emerald-400"
              href="mailto:contact@codewizard.training"
            >
              contact@codewizard.training
            </a>
          </div>
        </div>

        <div class="flex flex-col text-sm text-gray-600 dark:text-gray-400">
          <span class="pb-2">Built with ❤️ by Codewizard</span>
          <span>
            Powered by{" "}
            <a
              class="transition-colors hover:text-emerald-600 dark:hover:text-emerald-400"
              href="https://fastify.dev"
              target="_blank"
              rel="noopener noreferrer"
            >
              Fastify
            </a>
          </span>
        </div>

        <div class="flex space-x-6 text-sm text-gray-600 dark:text-gray-400">
          <a
            class="transition-colors hover:text-emerald-600 dark:hover:text-emerald-400"
            href="https://codewizard.training/terms"
            target="_blank"
            rel="noopener noreferrer"
          >
            Terms of Service
          </a>
          <a
            class="transition-colors hover:text-emerald-600 dark:hover:text-emerald-400"
            href="https://codewizard.training/privacy"
            target="_blank"
            rel="noopener noreferrer"
          >
            Privacy Policy
          </a>
          <a
            class="transition-colors hover:text-emerald-600 dark:hover:text-emerald-400"
            href="https://codewizard.training/cookies"
            target="_blank"
            rel="noopener noreferrer"
          >
            Cookie Policy
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
