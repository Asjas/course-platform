---
import SignupForm from "./SignupForm";

interface PricingTier {
  name: string;
  price: number;
  description: string;
  features: string[];
  stats: {
    duration: string;
    modules: string;
    lessons: string;
  };
  highlighted?: boolean;
  available: boolean;
  cta: string;
  ctaLink: string;
  footerText: string;
}

const tiers: PricingTier[] = [
  {
    name: "Preview Course",
    price: 0,
    description: "Try the course without paying",
    features: [
      "3 modules",
      "Stream and download DRM-free videos from any device",
      "Unlimited content updates",
    ],
    stats: {
      duration: "22 min",
      modules: "3 modules",
      lessons: "12 lessons",
    },
    available: true,
    cta: "Start Free",
    ctaLink: "#signup",
    footerText: "Try the course without paying.",
  },
  {
    name: "Full Course",
    price: 19,
    description: "Complete access to all content",
    features: [
      "All 13 modules",
      "Stream and download DRM-free videos from any device",
      "Unlimited content updates",
    ],
    stats: {
      duration: "256 min",
      modules: "13 modules",
      lessons: "88 lessons",
    },
    highlighted: true,
    available: true,
    cta: "Buy Full Course",
    ctaLink: "#signup",
    footerText: "30-day money-back guarantee.",
  },
];
---

<section
  id="pricing"
  class="py-20"
>
  <div class="container mx-auto max-w-6xl px-4">
    <div class="mb-16 text-center">
      <h2
        class="text-3xl font-bold text-gray-900 sm:text-4xl dark:text-white"
      >
        Simple, Transparent Pricing
      </h2>
      <p
        class="mx-auto mt-4 max-w-2xl text-lg text-gray-600 dark:text-gray-300"
      >
        These skills are timeless, and essential even in an AI-driven world.
      </p>
    </div>

    <div class="mx-auto grid max-w-4xl gap-8 md:grid-cols-2">
      {
        tiers.map((tier) => (
          <div
            class:list={[
              "relative flex flex-col rounded-2xl border p-8 transition-all",
              tier.highlighted
                ? "border-emerald-500 bg-white shadow-xl dark:bg-gray-800 md:scale-105"
                : "border-gray-200 bg-white hover:shadow-lg dark:border-gray-700 dark:bg-gray-800",
            ]}
          >
            {tier.highlighted && (
              <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-gradient-to-r from-emerald-500 to-teal-500 px-4 py-1 text-sm font-medium text-white">
                Best Value
              </span>
            )}

            <div class="mb-6">
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
                {tier.name}
              </h3>
              <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
                {tier.description}
              </p>
            </div>

            <div class="mb-6">
              <span class="text-4xl font-bold text-gray-900 dark:text-white">
                ${tier.price}
              </span>
              {tier.price === 0 && (
                <span class="ml-2 text-sm text-gray-500 dark:text-gray-400">
                  forever
                </span>
              )}
            </div>

            <ul class="mb-6 flex-1 space-y-3">
              {tier.features.map((feature) => (
                <li class="flex items-start gap-3 text-sm text-gray-600 dark:text-gray-300">
                  <svg
                    class="mt-0.5 h-5 w-5 flex-shrink-0 text-emerald-500"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M5 13l4 4L19 7"
                    />
                  </svg>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>

            <div class="mb-6 flex items-center justify-between text-xs text-gray-500 dark:text-gray-400">
              <div class="flex items-center gap-1">
                <svg
                  class="h-4 w-4 text-emerald-500"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z"
                    clip-rule="evenodd"
                  />
                </svg>
                <span>{tier.stats.duration}</span>
              </div>
              <div class="flex items-center gap-1">
                <svg
                  class="h-4 w-4 text-emerald-500"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a.999.999 0 01.356-.257l4-1.714a1 1 0 11.788 1.838L7.667 9.088l1.94.831a1 1 0 00.787 0l7-3a1 1 0 000-1.838l-7-3zM3.31 9.397L5 10.12v4.102a8.969 8.969 0 00-1.05-.174 1 1 0 01-.89-.89 11.115 11.115 0 01.25-3.762zM9.3 16.573A9.026 9.026 0 007 14.935v-3.957l1.818.78a3 3 0 002.364 0l5.508-2.361a11.026 11.026 0 01.25 3.762 1 1 0 01-.89.89 8.968 8.968 0 00-5.35 2.524 1 1 0 01-1.4 0zM6 18a1 1 0 001-1v-2.065a8.935 8.935 0 00-2-.712V17a1 1 0 001 1z" />
                </svg>
                <span>{tier.stats.modules}</span>
              </div>
              <div class="flex items-center gap-1">
                <svg
                  class="h-4 w-4 text-emerald-500"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M3 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z"
                    clip-rule="evenodd"
                  />
                </svg>
                <span>{tier.stats.lessons}</span>
              </div>
            </div>

            <a
              href={tier.ctaLink}
              class:list={[
                "inline-flex w-full items-center justify-center rounded-lg px-6 py-3 font-semibold transition-all",
                tier.highlighted
                  ? "bg-gradient-to-r from-emerald-500 to-teal-500 text-white hover:opacity-90"
                  : "border border-emerald-500 text-emerald-600 hover:bg-emerald-50 dark:text-emerald-400 dark:hover:bg-emerald-900/20",
              ]}
            >
              {tier.cta}
            </a>

            <p class="mt-4 text-center text-sm text-gray-500 dark:text-gray-400">
              {tier.footerText}
            </p>
          </div>
        ))
      }
    </div>

    <div class="mt-12 text-center">
      <div class="flex flex-wrap items-center justify-center gap-8">
        <div class="flex items-center gap-2">
          <svg
            class="h-5 w-5 text-emerald-500"
            fill="currentColor"
            viewBox="0 0 20 20"
          >
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
              clip-rule="evenodd"
            ></path>
          </svg>
          <span class="text-gray-600 dark:text-gray-300">Cancel anytime</span>
        </div>
        <div class="flex items-center gap-2">
          <svg
            class="h-5 w-5 text-emerald-500"
            fill="currentColor"
            viewBox="0 0 20 20"
          >
            <path
              fill-rule="evenodd"
              d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
              clip-rule="evenodd"
            ></path>
          </svg>
          <span class="text-gray-600 dark:text-gray-300">30-day guarantee</span>
        </div>
        <div class="flex items-center gap-2">
          <svg
            class="h-5 w-5 text-emerald-500"
            fill="currentColor"
            viewBox="0 0 20 20"
          >
            <path
              fill-rule="evenodd"
              d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z"
              clip-rule="evenodd"
            ></path>
          </svg>
          <span class="text-gray-600 dark:text-gray-300">Secure payment</span>
        </div>
      </div>
    </div>
  </div>
</section>
