---
const socialLinks = [
  {
    name: "Twitter / X",
    href: "https://twitter.com/AsjasM",
    icon: "twitter",
  },
  {
    name: "GitHub",
    href: "https://github.com/Asjas",
    icon: "github",
  },
  {
    name: "YouTube",
    href: "https://youtube.com/@codewizardtraining",
    icon: "youtube",
  },
];

const credentials = [
  "Building production Node.js applications for years",
  "Open-source contributor",
  "Passionate about teaching and sharing knowledge",
  "Creator of codewizard.training",
];
---

<section
  id="instructor"
  class="bg-gray-50 py-20 dark:bg-gray-900/50"
>
  <div class="container mx-auto max-w-6xl px-4">
    <div class="mb-16 text-center">
      <h2
        class="mb-4 text-3xl font-bold text-gray-900 sm:text-4xl dark:text-white"
      >
        Learn From an Expert
      </h2>
      <p class="mx-auto max-w-2xl text-lg text-gray-600 dark:text-gray-300">
        Get guidance from someone who's built production Fastify apps at scale.
      </p>
    </div>

    <div class="grid items-center gap-12 md:grid-cols-2">
      <div class="order-2 md:order-1">
        <h3 class="text-2xl font-bold text-gray-900 dark:text-white">
          Hey, I'm Asjas
        </h3>
        <p class="mt-4 text-gray-600 dark:text-gray-300">
          I've been building web applications and have watched Fastify evolve
          into an incredibly powerful Node.js framework. I use it in production
          and love how performant and developer-friendly it is.
        </p>
        <p class="mt-4 text-gray-600 dark:text-gray-300">
          This course is everything I wish I had when I started with Fastify. No
          fluff, no outdated patterns – just practical, real-world knowledge
          that will help you build production-ready applications.
        </p>

        <ul class="mt-6 space-y-3">
          {
            credentials.map((item) => (
              <li class="flex items-start gap-3 text-gray-600 dark:text-gray-300">
                <svg
                  class="mt-0.5 h-5 w-5 flex-shrink-0 text-green-500"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                  />
                </svg>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>

        <div class="mt-8 flex gap-4">
          {
            socialLinks.map((link) => (
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-lg border border-gray-200 p-2.5 text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-white"
                aria-label={link.name}
              >
                {link.icon === "twitter" && (
                  <svg
                    class="h-5 w-5"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                  </svg>
                )}
                {link.icon === "github" && (
                  <svg
                    class="h-5 w-5"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      fill-rule="evenodd"
                      clip-rule="evenodd"
                      d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                    />
                  </svg>
                )}
                {link.icon === "youtube" && (
                  <svg
                    class="h-5 w-5"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
                  </svg>
                )}
              </a>
            ))
          }
        </div>
      </div>

      <div class="order-1 flex justify-center md:order-2">
        <div class="relative">
          <div
            class="absolute -inset-4 rounded-full bg-gradient-to-br from-green-400 to-green-600 opacity-20 blur-2xl"
          ></div>
          <div
            class="relative overflow-hidden rounded-2xl border-4 border-white shadow-xl dark:border-gray-700"
          >
            <img
              src="/codewizard.jpg"
              alt="Course Instructor"
              class="h-80 w-80 object-cover"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
