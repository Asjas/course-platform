:80 {
	@static_asset {
		path_regexp \.(html|css|js|txt|json|jpg|png|ico|svg|woff|woff2)$
		not path_regexp \-([a-zA-Z0-9]{8})\.(css|js|svg)$
	}

	@immutable {
		path_regexp \-([a-zA-Z0-9]{7,8})\.(css|js|svg)$
	}

	root * /srv/app

	handle /sw.js {
		file_server

		header Cache-Control "public, no-cache, max-age=0"
	}

	handle @immutable {
		file_server

		header Cache-Control "public, max-age=31536000, immutable"
	}

	handle @static_asset {
		file_server

		header Cache-Control "public, max-age=3600"
	}

	handle {
		try_files {path} {path}/ /index.html
		file_server

		header Cache-Control "public, max-age=0, must-revalidate"
	}

	respond /health 200 {
		body `{"status": "ok"}`
	}
}
