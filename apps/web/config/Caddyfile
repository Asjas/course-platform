:80 {
	@static_asset {
		path_regexp \.(html|css|js|txt|json|jpg|png|ico|svg|woff|woff2)$
	}

	@immutable {
    path_regexp \-([a-zA-Z0-9]{8})\.(css|js|svg)$
  }

	log
  root * /srv/app
  encode zstd br gzip
  try_files {path} /index.html

  handle @static_asset {
    file_server @static_asset {
      precompressed zstd br gzip
    }

    header Cache-Control "public, max-age=3600"
  }

  handle /sw.js {
		header Cache-Control "public, no-cache, max-age=0"
  }

  handle @immutable {
		header Cache-Control "public, max-age=31536000, immutable"
	}

  handle {
    respond "Not Found" 404
  }

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self';"
		Permissions-Policy interest-cohort=()
		Strict-Transport-Security max-age=31556952;
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
	}

	respond /health 200 {
		body `{"status": "ok"}`
	}


	log {
		output file /var/log/access.log {
			roll_size 40MiB
			roll_uncompressed
			roll_local_time
		}
	}

	rate_limit {
		zone dynamic {
			key {remote_host}
			events 1000
			window 1m
		}
	}
}
