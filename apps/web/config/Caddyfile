:80 {
	@static_asset {
		path_regexp \.(html|css|js|txt|json|jpg|png|ico|svg|woff|woff2)$
		not path_regexp \-([a-zA-Z0-9]{7,8})\.(css|js|svg)$
	}

	@immutable path_regexp \-([a-zA-Z0-9]{7,8})\.(css|js|svg)$
  @serviceWorker path /sw.js
  @html path /index.html

	file_server
	root * /srv/app
  try_files {path} {path}/ /index.html

	header @serviceWorker Cache-Control "no-store, no-cache, must-revalidate"
  header @immutable Cache-Control "public, max-age=31536000, immutable"
  header @html Cache-Control "public, max-age=0, must-revalidate"
	header @static_asset Cache-Control "public, max-age=3600"
	
	respond /health 200 {
		body `{"status": "ok"}`
	}
}
