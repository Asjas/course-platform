{
	admin off
}

codewizard.training {
	@static_asset {
		path_regexp static \.(webp|svg|css|js|jpg|png|gif|ico|woff|woff2)$
	}

	@hashed_asset {
		path_regexp static \.(css|js)$
	}

	root * /srv/app
	encode gzip zstd
	try_files {path} /index.html
	file_server @static_asset
	log
	tls {
		issuer acme
	}

	header /index.html ?Cache-Control "public, max-age=60, must-revalidate"
	header @hashed_asset Cache-Control "public, max-age=31556952, immutable"

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self';"
		Permissions-Policy interest-cohort=()
		Strict-Transport-Security max-age=31556952;
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
	}

	respond /health 200 {
		body `{"status": "ok"}`
	}

	log {
		output file /var/log/access.log {
			roll_size 40MiB
			roll_uncompressed
			roll_local_time
		}
	}

	rate_limit {
		zone dynamic {
			key {remote_host}
			events 1000
			window 1m
		}
	}
}
