FROM postgres:18.0-alpine3.22

# Install musl-locales for locale support
RUN apk add --no-cache musl-locales musl-locales-lang

# Set environment variables for locale
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

# Configure PostgreSQL to use UTF8 encoding and en_US.UTF-8 locale during initdb
ENV POSTGRES_INITDB_ARGS="--encoding=UTF8 --locale=en_US.UTF-8"
