{
  "name": "@apps/server",
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "tsc && resolve-tspaths",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "drizzle:migrate": "drizzle-kit migrate --config ./src/drizzle.config.ts",
    "drizzle:generate": "drizzle-kit generate --config ./src/drizzle.config.ts",
    "drizzle:migrate:prod": "drizzle-kit migrate --config ./dist/drizzle.config.js",
    "drizzle:studio": "drizzle-kit studio",
    "clean": "rimraf dist/ node_modules/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.917.0",
    "@aws-sdk/s3-request-presigner": "3.917.0",
    "@fastify/autoload": "6.3.1",
    "@fastify/cors": "11.1.0",
    "@fastify/etag": "6.1.0",
    "@fastify/formbody": "8.0.2",
    "@fastify/helmet": "13.0.2",
    "@fastify/http-proxy": "11.3.0",
    "@fastify/multipart": "9.2.1",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/sensible": "6.0.3",
    "@polar-sh/better-auth": "1.1.11",
    "@polar-sh/sdk": "0.40.1",
    "@trpc/server": "11.6.0",
    "argon2": "0.44.0",
    "async-cache-dedupe": "3.2.0",
    "better-auth": "1.3.29",
    "close-with-grace": "2.3.0",
    "drizzle-orm": "0.44.7",
    "fastify": "5.6.1",
    "fastify-allow": "2.1.1",
    "fastify-better-auth": "1.2.0",
    "fastify-favicon": "5.0.0",
    "fastify-healthcheck": "5.1.0",
    "fastify-print-routes": "4.1.0",
    "fastify-type-provider-zod": "6.1.0",
    "ioredis": "5.8.2",
    "isbot": "5.1.31",
    "nodemailer": "7.0.10",
    "pg": "8.16.3",
    "pino": "10.1.0",
    "prom-client": "15.1.3",
    "resolve-tspaths": "0.8.23",
    "superjson": "2.2.3",
    "ulid": "3.0.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "24.7.2",
    "@types/nodemailer": "7.0.3",
    "@types/pg": "8.15.5",
    "@vitest/coverage-v8": "4.0.3",
    "drizzle-kit": "0.31.5",
    "rimraf": "6.0.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "4.0.3"
  },
  "optionalDependencies": {
    "pg-native": "3.5.2"
  }
}
