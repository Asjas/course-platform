{
  "name": "@apps/server",
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "tsc && resolve-tspaths",
    "start": "node -r tsconfig-paths/register dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "drizzle:migrate": "drizzle-kit migrate --config ./src/drizzle.config.ts",
    "drizzle:generate": "drizzle-kit generate --config ./src/drizzle.config.ts",
    "drizzle:studio": "drizzle-kit studio",
    "clean": "rimraf dist/ node_modules/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@asjas/fastify-nodemailer": "1.0.4",
    "@epic-web/invariant": "1.0.0",
    "@fastify/autoload": "6.3.1",
    "@fastify/cors": "11.1.0",
    "@fastify/etag": "6.0.3",
    "@fastify/formbody": "8.0.2",
    "@fastify/helmet": "13.0.2",
    "@fastify/multipart": "9.2.1",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/sensible": "6.0.3",
    "@polar-sh/better-auth": "1.1.7",
    "@polar-sh/sdk": "0.35.4",
    "@trpc/server": "11.6.0",
    "argon2": "0.44.0",
    "better-auth": "1.3.25",
    "close-with-grace": "2.3.0",
    "dotenv": "17.2.3",
    "drizzle-orm": "0.44.6",
    "env-schema": "6.0.1",
    "fastify": "5.6.1",
    "fastify-allow": "2.1.1",
    "fastify-better-auth": "1.2.0",
    "fastify-favicon": "5.0.0",
    "fastify-healthcheck": "5.1.0",
    "fastify-plugin": "5.1.0",
    "fastify-print-routes": "4.1.0",
    "fluent-json-schema": "6.0.0",
    "ioredis": "5.8.0",
    "isbot": "5.1.31",
    "pg": "8.16.3",
    "pino": "10.0.0",
    "resolve-tspaths": "0.8.23",
    "ulid": "3.0.1",
    "undici": "7.16.0",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@types/node": "24.6.2",
    "@types/pg": "8.15.5",
    "@vitest/coverage-v8": "3.2.4",
    "drizzle-kit": "0.31.5",
    "rimraf": "6.0.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.4"
  },
  "optionalDependencies": {
    "pg-native": "3.5.2"
  }
}
