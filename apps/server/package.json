{
  "name": "@apps/server",
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "tsc && resolve-tspaths",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "drizzle:migrate": "drizzle-kit migrate --config ./src/drizzle.config.ts",
    "drizzle:generate": "drizzle-kit generate --config ./src/drizzle.config.ts",
    "drizzle:migrate:prod": "drizzle-kit migrate --config ./dist/drizzle.config.js",
    "drizzle:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1037.0",
    "@aws-sdk/s3-request-presigner": "3.1037.0",
    "@fastify/autoload": "6.3.1",
    "@fastify/cors": "11.2.0",
    "@fastify/etag": "6.1.0",
    "@fastify/formbody": "8.0.2",
    "@fastify/helmet": "13.0.2",
    "@fastify/http-proxy": "11.4.4",
    "@fastify/multipart": "10.0.0",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/sensible": "6.0.4",
    "@polar-sh/better-auth": "1.8.3",
    "@polar-sh/sdk": "0.46.7",
    "@trpc/server": "11.16.0",
    "argon2": "0.44.0",
    "async-cache-dedupe": "3.4.0",
    "better-auth": "1.6.9",
    "close-with-grace": "2.5.0",
    "drizzle-orm": "0.45.2",
    "fastify": "5.8.5",
    "fastify-allow": "2.1.1",
    "fastify-better-auth": "1.2.0",
    "fastify-favicon": "5.0.0",
    "fastify-healthcheck": "5.1.0",
    "fastify-print-routes": "5.0.1",
    "fastify-type-provider-zod": "6.1.0",
    "ioredis": "5.10.1",
    "isbot": "5.1.39",
    "nodemailer": "8.0.6",
    "p-limit": "7.3.0",
    "pg": "8.20.0",
    "pino": "10.3.1",
    "prom-client": "15.1.3",
    "resolve-tspaths": "0.8.23",
    "superjson": "2.2.6",
    "ulid": "3.0.2",
    "undici": "8.1.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "1.63.0",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/node": "25.6.0",
    "@types/nodemailer": "8.0.0",
    "@types/pg": "8.20.0",
    "@vitest/coverage-v8": "4.1.5",
    "drizzle-kit": "0.31.10",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.5"
  },
  "optionalDependencies": {
    "pg-native": "3.7.0"
  }
}
