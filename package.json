{
  "author": "A-J Roos <asjasroos@proton.me>",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9+sha512.68046141893c66fad01c079231128e9afb89ef87e2691d69e4d40eee228988295fd4682181bae55b58418c3a253bde65a505ec7c5f9403ece5cc3cd37dcf2531",
  "scripts": {
    "dev": "pnpm run -parallel -filter \"./apps/**\" dev",
    "build": "pnpm run -recursive -filter \"./apps/**\" build",
    "lint": "eslint --cache --cache-location .cache/eslint --cache-strategy content .",
    "prettier": "prettier \"**/*.+(ts|tsx)\"",
    "format": "npm run prettier -- --write --cache --cache --cache-location .cache/prettier",
    "check-format": "npm run prettier -- --list-different --cache --cache --cache-location .cache/prettier",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{html,js,jsx,ts,tsx,astro,md,json}": [
      "prettier --write",
      "eslint --concurrency auto --fix"
    ]
  },
  "devDependencies": {
    "@eslint/compat": "1.4.0",
    "@eslint/js": "9.36.0",
    "@tanstack/eslint-plugin-router": "1.132.31",
    "@trivago/prettier-plugin-sort-imports": "5.2.2",
    "@types/eslint-plugin-security": "3.0.0",
    "@xeonlink/prettier-plugin-organize-attributes": "1.1.0",
    "eslint": "9.36.0",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-astro": "1.3.1",
    "eslint-plugin-es-x": "9.1.0",
    "eslint-plugin-html": "8.1.3",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-json": "4.0.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-n": "17.23.1",
    "eslint-plugin-promise": "7.2.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "6.1.0",
    "eslint-plugin-security": "3.0.1",
    "eslint-plugin-unused-imports": "4.2.0",
    "eslint-plugin-yml": "1.18.0",
    "globals": "16.4.0",
    "husky": "9.1.7",
    "lint-staged": "16.2.3",
    "prettier": "3.6.2",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.6.14",
    "typescript-eslint": "8.45.0"
  }
}
