{
  "author": "A-J Roos <asjasroos@proton.me>",
  "license": "MIT",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "pnpm run --parallel --filter \"./apps/**\" dev",
    "tauri:dev": "pnpm run --filter \"./apps/web\" tauri:dev",
    "tauri:build": "turbo run tauri:build --filter \"./apps/web\"",
    "build": "turbo build --filter \"./apps/**\"",
    "test": "turbo test --filter \"./apps/**\"",
    "lint": "eslint --cache --cache-location .cache/eslint --cache-strategy content .",
    "prettier": "prettier \"**/*.+(ts|tsx)\"",
    "format": "npm run prettier -- --write --cache --cache-location .cache/prettier",
    "check-format": "npm run prettier -- --list-different --cache --cache-location .cache/prettier",
    "typecheck": "turbo --filter \"./apps/**\" typecheck",
    "clean": "rimraf {apps,packages}/*/node_modules {apps,packages}/*/dist {apps,packages}/*/.turbo {apps,packages}/*/.tanstack {apps,packages}/*/.cache {apps,packages}/*/tsconfig*.tsbuildinfo node_modules/",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{html,js,jsx,ts,tsx,astro,md,json}": [
      "prettier --write --cache --cache-location .cache/prettier",
      "eslint --cache --cache-location .cache/eslint --cache-strategy content --fix"
    ]
  },
  "dependencies": {
    "argon2": "0.44.0",
    "pg": "8.17.1",
    "ulid": "3.0.2"
  },
  "devDependencies": {
    "@eslint/compat": "2.0.2",
    "@eslint/eslintrc": "3.3.3",
    "@eslint/js": "9.39.2",
    "@tanstack/eslint-plugin-query": "5.91.4",
    "@tanstack/eslint-plugin-router": "1.141.0",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/eslint-plugin-security": "3.0.0",
    "@xeonlink/prettier-plugin-organize-attributes": "1.1.0",
    "eslint": "9.39.2",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-astro": "1.5.0",
    "eslint-plugin-cypress": "5.2.1",
    "eslint-plugin-es-x": "9.3.0",
    "eslint-plugin-html": "8.1.3",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-import-zod": "1.2.1",
    "eslint-plugin-json": "4.0.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-n": "17.23.2",
    "eslint-plugin-promise": "7.2.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "eslint-plugin-security": "3.0.1",
    "eslint-plugin-unused-imports": "4.3.0",
    "eslint-plugin-yml": "3.0.0",
    "globals": "17.0.0",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "prettier": "3.8.1",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.7.2",
    "rimraf": "6.1.2",
    "tsx": "4.21.0",
    "turbo": "2.7.5",
    "typescript-eslint": "8.53.0"
  }
}
