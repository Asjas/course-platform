{
  "author": "A-J Roos <asjasroos@proton.me>",
  "license": "MIT",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "dev": "pnpm run -parallel -filter \"./apps/**\" dev",
    "build": "turbo build --filter \"./apps/**\" build",
    "test": "turbo test --filter \"./apps/**\" test",
    "lint": "eslint --cache --cache-location .cache/eslint --cache-strategy content .",
    "prettier": "prettier \"**/*.+(ts|tsx)\"",
    "format": "npm run prettier -- --write --cache --cache-location .cache/prettier",
    "check-format": "npm run prettier -- --list-different --cache --cache-location .cache/prettier",
    "typecheck": "turbo --filter \"./apps/**\" typecheck",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{html,js,jsx,ts,tsx,astro,md,json}": [
      "prettier --write --cache --cache-location .cache/prettier",
      "eslint --cache --cache-location .cache/eslint --cache-strategy content --fix"
    ]
  },
  "devDependencies": {
    "@eslint/compat": "1.4.0",
    "@eslint/js": "9.38.0",
    "@tanstack/eslint-plugin-query": "5.91.2",
    "@tanstack/eslint-plugin-router": "1.133.3",
    "@trivago/prettier-plugin-sort-imports": "5.2.2",
    "@types/eslint-plugin-security": "3.0.0",
    "@xeonlink/prettier-plugin-organize-attributes": "1.1.0",
    "eslint": "9.38.0",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-astro": "1.3.1",
    "eslint-plugin-cypress": "5.2.0",
    "eslint-plugin-es-x": "9.1.1",
    "eslint-plugin-html": "8.1.3",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-import-zod": "1.2.0",
    "eslint-plugin-json": "4.0.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-n": "17.23.1",
    "eslint-plugin-promise": "7.2.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "7.0.0",
    "eslint-plugin-react-refresh": "0.4.24",
    "eslint-plugin-security": "3.0.1",
    "eslint-plugin-unused-imports": "4.3.0",
    "eslint-plugin-yml": "1.19.0",
    "globals": "16.4.0",
    "husky": "9.1.7",
    "lint-staged": "16.2.4",
    "prettier": "3.6.2",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.7.1",
    "turbo": "2.5.8",
    "typescript-eslint": "8.46.1"
  }
}
