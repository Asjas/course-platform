{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".astro/**", "!.turbo/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "typecheck": {
      "outputs": ["tsconfig.tsbuildinfo"]
    },
    "drizzle:generate": {
      "outputs": ["drizzle/**"]
    },
    "drizzle:migrate": {
      "dependsOn": ["drizzle:generate"]
    }
  },
  "globalDependencies": [
    "package.json",
    "tsconfig.base.json",
    "tsconfig.json",
    "turbo.json",
    ".prettierrc",
    "eslint.config.js"
  ],
  "remoteCache": {
    "teamSlug": "codewizard",
    "enabled": true,
    "apiUrl": "https://turborepo.codewizard.training"
  }
}
