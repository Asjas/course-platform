{
  "$schema": "https://v2-9-6.turborepo.dev/schema.json",
  "globalPassThroughEnv": ["*"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".astro/**"],
      "env": ["CYPRESS_COVERAGE"]
    },
    "tauri:build": {
      "dependsOn": ["build"],
      "outputs": ["src-tauri/target/**"],
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**/*.{ts,tsx}",
        "tests/**/*.{ts,tsx}",
        "types/**/*.d.ts",
        "vitest.config.ts",
        "vite.config.ts",
        ".env",
        "package.json",
        "tsconfig.json"
      ],
      "env": ["DATABASE_SCHEMA", "DATABASE_URL", "CI"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**/*.{ts,tsx}",
        "tests/**/*.{ts,tsx}",
        "types/**/*.d.ts",
        "vitest.config.ts",
        "vite.config.ts",
        ".env",
        "package.json",
        "tsconfig.json"
      ],
      "outputs": ["coverage/**"],
      "env": ["DATABASE_SCHEMA", "DATABASE_URL", "CI"]
    },
    "e2e:run": {
      "dependsOn": ["build"],
      "cache": false,
      "inputs": [
        "cypress.config.ts",
        "cypress/**/*.ts",
        "src/**/*.{ts,tsx,css}",
        "public/**",
        "index.html",
        "vite.config.ts",
        "../server/src/**/*.ts",
        "../server/package.json",
        "../../scripts/seed-test-data.ts",
        "../../scripts/cleanup-test-data.ts"
      ],
      "outputs": ["cypress/screenshots/**", "cypress/videos/**"],
      "env": ["DATABASE_SCHEMA", "DATABASE_URL", "CI"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [".cache/tsbuildinfo/**"]
    }
  },
  "globalDependencies": ["package.json", "tsconfig.json", "turbo.json"],
  "remoteCache": {
    "teamSlug": "codewizard",
    "enabled": true,
    "apiUrl": "https://turborepo.codewizard.training"
  }
}
