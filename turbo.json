{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".astro/**"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    }
  },
  "globalDependencies": ["package.json", "tsconfig.json", "turbo.json"],
  "remoteCache": {
    "teamSlug": "codewizard",
    "enabled": true,
    "apiUrl": "https://turborepo.codewizard.training"
  }
}
