{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".astro/**"]
    },
    "tauri:build": {
      "dependsOn": ["build"],
      "outputs": ["src-tauri/target/**"],
      "cache": false
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "test:coverage": {
      "dependsOn": ["^test"],
      "outputs": ["coverage/**"]
    },
    "e2e:run": {
      "dependsOn": ["build"],
      "inputs": [
        "cypress.config.ts",
        "cypress/**/*.ts",
        "src/**/*.{ts,tsx,css}",
        "public/**",
        "index.html",
        "vite.config.ts",
        "../server/src/**/*.ts",
        "../server/package.json",
        "../../scripts/seed-test-data.ts",
        "../../scripts/cleanup-test-data.ts"
      ],
      "outputs": ["cypress/screenshots/**", "cypress/videos/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [".cache/tsbuildinfo/**"]
    }
  },
  "globalDependencies": ["package.json", "tsconfig.json", "turbo.json"],
  "remoteCache": {
    "teamSlug": "codewizard",
    "enabled": true,
    "apiUrl": "https://turborepo.codewizard.training"
  }
}
